# question: Where has unit ?unit been, and what failed while it was there?
# bindings: ?unit (IRI)
PREFIX ftf: <https://domain-explorer.dev/ftf#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?pos ?from ?to ?fe ?mode ?on WHERE {
  ?i a ftf:Installation ; ftf:unit ?unit ; ftf:position ?pos ; ftf:from_date ?from .
  OPTIONAL { ?i ftf:to_date ?to }
  OPTIONAL { ?fe a ftf:FailureEvent ; ftf:installation ?i ; ftf:mode ?mode ; ftf:occurred_on ?on }
} ORDER BY ?from ?on
