ftf:FailureMode a owl:Class ;
    rdfs:label "FailureMode" ;
    owl:unionOf ( <https://domain-explorer.dev/ftf#FailureMode#VIB> <https://domain-explorer.dev/ftf#FailureMode#ELP> <https://domain-explorer.dev/ftf#FailureMode#ELU> <https://domain-explorer.dev/ftf#FailureMode#OHE> <https://domain-explorer.dev/ftf#FailureMode#BRD> <https://domain-explorer.dev/ftf#FailureMode#FTS> <https://domain-explorer.dev/ftf#FailureMode#STP> <https://domain-explorer.dev/ftf#FailureMode#NOI> <https://domain-explorer.dev/ftf#FailureMode#PDE> <https://domain-explorer.dev/ftf#FailureMode#INL> <https://domain-explorer.dev/ftf#FailureMode#ERO> <https://domain-explorer.dev/ftf#FailureMode#SER> ) ;
    skos:definition "Failure modes after ISO 14224 (codes as used in the Annex B equipment tables)." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> ;
    linkml:permissible_values <https://domain-explorer.dev/ftf#FailureMode#BRD>,
        <https://domain-explorer.dev/ftf#FailureMode#ELP>,
        <https://domain-explorer.dev/ftf#FailureMode#ELU>,
        <https://domain-explorer.dev/ftf#FailureMode#ERO>,
        <https://domain-explorer.dev/ftf#FailureMode#FTS>,
        <https://domain-explorer.dev/ftf#FailureMode#INL>,
        <https://domain-explorer.dev/ftf#FailureMode#NOI>,
        <https://domain-explorer.dev/ftf#FailureMode#OHE>,
        <https://domain-explorer.dev/ftf#FailureMode#PDE>,
        <https://domain-explorer.dev/ftf#FailureMode#SER>,
        <https://domain-explorer.dev/ftf#FailureMode#STP>,
        <https://domain-explorer.dev/ftf#FailureMode#VIB> .

ftf:PhysicalEquipment a owl:Class ;
    rdfs:label "PhysicalEquipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:parent_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:built_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:serial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:serial ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:built_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:parent_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:PhysicalEquipment ;
            owl:onProperty ftf:parent_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:serial ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:manufacturer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:built_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:build_lots ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:Organization ;
            owl:onProperty ftf:manufacturer ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:MaterialLot ;
            owl:onProperty ftf:build_lots ],
        ftf:Entity ;
    skos:definition "A UNIT. A serial-numbered thing that can be built, installed, moved, repaired and scrapped." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:FunctionalLocation a owl:Class ;
    rdfs:label "FunctionalLocation" ;
    rdfs:subClassOf [ a owl:Restriction ;
