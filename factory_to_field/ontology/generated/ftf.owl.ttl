@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ftf: <https://domain-explorer.dev/ftf#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ftf:Deferment a owl:Class ;
    rdfs:label "Deferment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:well ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:reason ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:well ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:reason ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:reason ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:Well ;
            owl:onProperty ftf:well ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:barrels_per_day ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:barrels_per_day ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ftf:barrels_per_day ] ;
    skos:definition "Production lost or at risk while a well runs degraded or is down." ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> .

ftf:ESPPosition a owl:Class ;
    rdfs:label "ESPPosition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:setting_depth_m ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:setting_depth_m ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ftf:setting_depth_m ],
        ftf:FunctionalLocation ;
    skos:definition "The artificial-lift position in a well (the ESP slot), under the Well." ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> .

ftf:ESPString a owl:Class ;
    rdfs:label "ESPString" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:components ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:ESPComponent ;
            owl:onProperty ftf:components ],
        ftf:PhysicalEquipment ;
    skos:definition "A complete submersible pump string as run in a well." ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> .

ftf:LinkAssertion a owl:Class ;
    rdfs:label "LinkAssertion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty ftf:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:LinkMethod ;
            owl:onProperty ftf:method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:subject ] ;
    skos:definition "Provenance of one identity or relationship link between source records." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:OilField a owl:Class ;
    rdfs:label "OilField" ;
    rdfs:subClassOf ftf:Site ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> .

ftf:ProcessUnit a owl:Class ;
    rdfs:label "ProcessUnit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:capacity_bpd ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:capacity_bpd ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ftf:capacity_bpd ],
        ftf:FunctionalLocation ;
    skos:definition "A process unit such as a crude distillation unit; positions hang under it." ;
    skos:inScheme <https://domain-explorer.dev/ftf/refinery> .

ftf:PumpPosition a owl:Class ;
    rdfs:label "PumpPosition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:api_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:api_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:api_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:rated_flow_m3h ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:rated_flow_m3h ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:service ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ftf:rated_flow_m3h ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:service ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:service ],
        ftf:FunctionalLocation ;
    skos:inScheme <https://domain-explorer.dev/ftf/refinery> .

<https://domain-explorer.dev/ftf.owl.ttl> a owl:Ontology ;
    rdfs:label "ftf" ;
    dcterms:title "Factory to Field ontology v0.1" ;
    pav:version "0.1.0" ;
    skos:definition "Umbrella schema. Import this one to get every module." .

ftf:BuildRecord a owl:Class ;
    rdfs:label "BuildRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:lots ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:built_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:work_order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:built_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:work_order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:work_order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:built_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:PhysicalEquipment ;
            owl:onProperty ftf:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:MaterialLot ;
            owl:onProperty ftf:lots ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:unit ],
        ftf:Entity ;
    skos:inScheme <https://domain-explorer.dev/ftf/factory> .

ftf:Draft a owl:Class ;
    rdfs:label "Draft" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:case ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:DraftStatus ;
            owl:onProperty ftf:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:target_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:Case ;
            owl:onProperty ftf:case ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:approved_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:case ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:target_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:required_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:target_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:approved_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:approved_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:required_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:required_role ],
        ftf:Entity ;
    skos:definition "A proposed write to a system of record. Never applied without a named approver." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:ESPComponent a owl:Class ;
    rdfs:label "ESPComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:ESPComponentKind ;
            owl:onProperty ftf:kind ],
        ftf:PhysicalEquipment ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> .

ftf:EightD a owl:Class ;
    rdfs:label "EightD" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:root_cause ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:root_cause ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:root_cause ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:covers_claims ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:containment_units ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:WarrantyClaim ;
            owl:onProperty ftf:covers_claims ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:PhysicalEquipment ;
            owl:onProperty ftf:containment_units ],
        ftf:Entity ;
    skos:definition "Corrective-action report (8D). Always created as a draft by agents." ;
    skos:inScheme <https://domain-explorer.dev/ftf/factory> .

ftf:FailureEvent a owl:Class ;
    rdfs:label "FailureEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ftf:FailureMode ;
            owl:onProperty ftf:mode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:installation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:mode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:installation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:Installation ;
            owl:onProperty ftf:installation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:of_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:PhysicalEquipment ;
            owl:onProperty ftf:of_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:at_position ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:of_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:at_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:FunctionalLocation ;
            owl:onProperty ftf:at_position ],
        ftf:Event ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:KpiDefinition a owl:Class ;
    rdfs:label "KpiDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:grain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:grain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:grain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:question ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:question ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:standard ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:question ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:method ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:standard ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:standard ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:query ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:query ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:query ],
        ftf:Entity ;
    skos:inScheme <https://domain-explorer.dev/ftf/kpi> .

ftf:ManagementOfChange a owl:Class ;
    rdfs:label "ManagementOfChange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:approved_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:approved_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:affects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:approved_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:FunctionalLocation ;
            owl:onProperty ftf:affects ],
        ftf:Entity ;
    skos:definition "A plant change request; ties engineering changes to positions." ;
    skos:inScheme <https://domain-explorer.dev/ftf/refinery> .

ftf:NonConformance a owl:Class ;
    rdfs:label "NonConformance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:lots ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:opened_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:opened_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:MaterialLot ;
            owl:onProperty ftf:lots ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:opened_on ],
        ftf:Entity ;
    skos:inScheme <https://domain-explorer.dev/ftf/factory> .

ftf:Notification a owl:Class ;
    rdfs:label "Notification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:about_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:about_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:about_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:about_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:PhysicalEquipment ;
            owl:onProperty ftf:about_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:FunctionalLocation ;
            owl:onProperty ftf:about_position ],
        ftf:Event ;
    skos:definition "A maintenance notification or malfunction report." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:RunRecord a owl:Class ;
    rdfs:label "RunRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:installation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:end_state ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:EndState ;
            owl:onProperty ftf:end_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:run_days ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:installation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:end ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:end_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:run_days ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:Installation ;
            owl:onProperty ftf:installation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ftf:run_days ],
        ftf:Entity ;
    skos:definition "One run of a string in a well. Run life belongs to the string, not to the well." ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> .

ftf:Shipment a owl:Class ;
    rdfs:label "Shipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:shipped_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:PhysicalEquipment ;
            owl:onProperty ftf:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:customer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:shipped_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:Organization ;
            owl:onProperty ftf:customer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:shipped_on ],
        ftf:Entity ;
    skos:inScheme <https://domain-explorer.dev/ftf/factory> .

ftf:Signal a owl:Class ;
    rdfs:label "Signal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:engineering_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:sample_seconds ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:quantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:engineering_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:engineering_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:measures_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:sample_seconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:quantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:quantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ftf:sample_seconds ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:alarm_high ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:FunctionalLocation ;
            owl:onProperty ftf:measures_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:alarm_high ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ftf:alarm_high ],
        ftf:Entity ;
    skos:definition "A measured or computed time series (historian tag, SCADA point)." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:SourceIdentifier a owl:Class ;
    rdfs:label "SourceIdentifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:value ],
        [ a owl:Restriction ;
