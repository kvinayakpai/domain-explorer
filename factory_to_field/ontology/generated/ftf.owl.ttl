    rdfs:label "ESPComponentKind" ;
    owl:unionOf ( <https://domain-explorer.dev/ftf#ESPComponentKind#pump> <https://domain-explorer.dev/ftf#ESPComponentKind#intake> <https://domain-explorer.dev/ftf#ESPComponentKind#seal_section> <https://domain-explorer.dev/ftf#ESPComponentKind#motor> <https://domain-explorer.dev/ftf#ESPComponentKind#cable> <https://domain-explorer.dev/ftf#ESPComponentKind#sensor> ) ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> ;
