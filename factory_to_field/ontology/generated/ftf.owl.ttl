        [ a owl:Restriction ;
            owl:allValuesFrom ftf:SourceIdentifier ;
            owl:onProperty ftf:identifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:id ],
        [ owl:unionOf ( ftf:BuildRecord ftf:Case ftf:Document ftf:Draft ftf:EightD ftf:EngineeringChange ftf:Event ftf:FunctionalLocation ftf:Installation ftf:KpiDefinition ftf:ManagementOfChange ftf:MaterialLot ftf:NonConformance ftf:Organization ftf:PhysicalEquipment ftf:RunRecord ftf:Shipment ftf:Signal ftf:Site ftf:Stream ftf:TestRecord ftf:WarrantyClaim ) ] ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .


