ftf:DraftStatus a owl:Class ;
    rdfs:label "DraftStatus" ;
    owl:unionOf ( <https://domain-explorer.dev/ftf#DraftStatus#pending> <https://domain-explorer.dev/ftf#DraftStatus#approved> <https://domain-explorer.dev/ftf#DraftStatus#rejected> ) ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> ;
    linkml:permissible_values <https://domain-explorer.dev/ftf#DraftStatus#approved>,
        <https://domain-explorer.dev/ftf#DraftStatus#pending>,
        <https://domain-explorer.dev/ftf#DraftStatus#rejected> .

ftf:EndState a owl:Class ;
    rdfs:label "EndState" ;
    owl:unionOf ( <https://domain-explorer.dev/ftf#EndState#failed> <https://domain-explorer.dev/ftf#EndState#running> <https://domain-explorer.dev/ftf#EndState#pulled_for_other> ) ;
    skos:definition "How a run of a string ended." ;
    skos:inScheme <https://domain-explorer.dev/ftf/oilfield> ;
    linkml:permissible_values <https://domain-explorer.dev/ftf#EndState#failed>,
        <https://domain-explorer.dev/ftf#EndState#pulled_for_other>,
        <https://domain-explorer.dev/ftf#EndState#running> .

ftf:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty ftf:occurred_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:occurred_on ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ftf:occurred_on ],
        [ owl:unionOf ( ftf:FailureEvent ftf:Notification ftf:Workover ) ],
        ftf:Entity ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:MaterialLot a owl:Class ;
    rdfs:label "MaterialLot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:material ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:supplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:material ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:material ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:supplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:Organization ;
            owl:onProperty ftf:supplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:introduced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:introduced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom ftf:EngineeringChange ;
            owl:onProperty ftf:introduced_by ],
        ftf:Entity ;
    skos:definition "A homogeneous batch of a purchased material (bearing set, elastomer compound)." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

ftf:World a owl:Class ;
    rdfs:label "World" ;
    owl:unionOf ( <https://domain-explorer.dev/ftf#World#OT> <https://domain-explorer.dev/ftf#World#IT> <https://domain-explorer.dev/ftf#World#ET> ) ;
    skos:definition "Which of the three data worlds a record comes from (OT / IT / ET)." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> ;
    linkml:permissible_values <https://domain-explorer.dev/ftf#World#ET>,
        <https://domain-explorer.dev/ftf#World#IT>,
        <https://domain-explorer.dev/ftf#World#OT> .

ftf:lots a owl:ObjectProperty .

ftf:Severity a owl:Class ;
    rdfs:label "Severity" ;
    owl:unionOf ( <https://domain-explorer.dev/ftf#Severity#low> <https://domain-explorer.dev/ftf#Severity#medium> <https://domain-explorer.dev/ftf#Severity#high> <https://domain-explorer.dev/ftf#Severity#critical> ) ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> ;
    linkml:permissible_values <https://domain-explorer.dev/ftf#Severity#critical>,
        <https://domain-explorer.dev/ftf#Severity#high>,
        <https://domain-explorer.dev/ftf#Severity#low>,
        <https://domain-explorer.dev/ftf#Severity#medium> .

ftf:about_unit a owl:ObjectProperty .

ftf:LinkMethod a owl:Class ;
    rdfs:label "LinkMethod" ;
    owl:unionOf ( <https://domain-explorer.dev/ftf#LinkMethod#exact_key> <https://domain-explorer.dev/ftf#LinkMethod#tag_rule> <https://domain-explorer.dev/ftf#LinkMethod#alias_table> <https://domain-explorer.dev/ftf#LinkMethod#fuzzy> <https://domain-explorer.dev/ftf#LinkMethod#human> ) ;
    skos:definition "How an identity link between two source records was established." ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> ;
    linkml:permissible_values <https://domain-explorer.dev/ftf#LinkMethod#alias_table>,
        <https://domain-explorer.dev/ftf#LinkMethod#exact_key>,
        <https://domain-explorer.dev/ftf#LinkMethod#fuzzy>,
        <https://domain-explorer.dev/ftf#LinkMethod#human>,
        <https://domain-explorer.dev/ftf#LinkMethod#tag_rule> .

ftf:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ftf:org_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ftf:org_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ftf:org_kind ],
        ftf:Entity ;
    skos:inScheme <https://domain-explorer.dev/ftf/core> .

